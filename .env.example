# ==============================================================================
# MetaFusion Environment Variables Template
# 复制为 .env 并填入真实值： cp .env.example .env
# 生产环境务必修改所有 CHANGE_ME_* 为强随机值，切勿使用默认值
# ==============================================================================

# 基础端口
HTTP_PORT=80
HTTPS_PORT=443
MINIO_CONSOLE_PORT=9001

# PostgreSQL 配置
DB_USER=metafusion
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=metafusion_db

# MinIO / S3 访问密钥
MINIO_ROOT_USER=admin_metafusion
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD_MIN_16_CHARS

# S3 公网访问端点 (前端生成直传预签名 URL，本地开发保持 http://localhost:9000)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# 认证与 JWT 密钥 (生产环境必须为 32+ 随机字符)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32_OR_uuidgen

# 转码配置
MAX_CONCURRENT_VIDEO_TASKS=2

# 可选：外部访问域名（用于预签名 URL 与回调）
# APP_BASE_URL=http://localhost
