# ==============================================================================
# MetaFusion Environment Variables Template
# 复制为 .env 并填入真实值： cp .env.example .env
# 生产环境务必修改所有 CHANGE_ME_* 为强随机值，切勿使用默认值
# ==============================================================================

# 基础端口 (外部反向代理指向此端口，如 Nginx/Caddy 反代 http://127.0.0.1:10100)
HTTP_PORT=10100

# PostgreSQL 配置
DB_USER=metafusion
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=metafusion_db

# 对象存储（RustFS，S3 协议）凭据：唯一来源。编排把它同时喂给 rustfs 容器（canonical 名
# RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY，旧名别名 RUSTFS_ROOT_USER / RUSTFS_ROOT_PASSWORD）
# 与存储服务的 STORAGE_S3_ACCESS_KEY / STORAGE_S3_SECRET_KEY；目录服务不读它。
RUSTFS_ROOT_USER=admin_metafusion
RUSTFS_ROOT_PASSWORD=CHANGE_ME_STRONG_OBJECT_STORE_PASSWORD

# RS256 访问令牌**签发**（只有账号服务 auth 用；AUTH_JWT_PRIVATE_KEY 为空则用进程内临时密钥，
# 重启旧令牌失效；生产必须配置持久 RSA 私钥 PEM 或其 base64，可用 openssl genrsa -out jwt.pem 2048 生成）
# 私钥只在 auth：目录 backend 只验签、不需要也不需要拿到签发私钥。
# AUTH_JWT_PRIVATE_KEY=CHANGE_ME_RSA_PRIVATE_KEY_PEM_OR_BASE64
# issuer 与 audience 必须与存量令牌一致，默认值即线上值，不要按部署环境改动。
# AUTH_JWT_ISSUER=https://findverse.cc/api
# AUTH_JWT_AUDIENCE=metafusion

# 目录服务 backend 的验签来源，按优先级：AUTH_JWT_PUBLIC_KEY → AUTH_JWKS_URL → 私钥兜底。
# 生产推荐配公钥（少一条网络依赖），或留空 JWKS 让 backend 直接拉账号服务的公钥（10 分钟缓存，
# 未知 kid 会强制刷新，适合平滑轮换）。
# 公钥从签发私钥导出：openssl rsa -in jwt.pem -pubout -out jwt.pub；PEM 文本或其 base64 都接受。
# 这里只接受公钥：把私钥填进 AUTH_JWT_PUBLIC_KEY 会让 backend 直接启动失败（防止密钥继续扩散）。
# 轮换窗口：先发布 auth，JWKS 模式下目录 10 分钟内自动跟上；静态公钥模式需要重启 backend。
# 两种都没配、私钥兜底也为空时，目录写接口一律按未登录处理（fail closed，公开读不受影响）。
# AUTH_JWT_PUBLIC_KEY=CHANGE_ME_RSA_PUBLIC_KEY_PEM_OR_BASE64
# 覆盖 JWKS 地址时用同一个变量名（编排里的默认值即账号服务的公钥端点，无需手填）。
# 注意：不要在这一行写出 变量名=URL 的字面形式——gitleaks 的 generic-api-key 规则会把
# 这种「键=高熵值」当成疑似密钥，已于 2026-09-16 触发过一次 CI 失败。

# 本地构建镜像的标签（可选）：主编排里目录 backend 与账号 / 互动 / 存储的构建镜像都用它打标签；
# 前端与文档站不在这里命名（compose 按工程名自动命名），预构建镜像路径见 docker-compose.prod.yml。
# METAFUSION_TAG=local

# 存储服务 (metafusion-storage) 预签名直传的对外地址。
# 编排不把对象存储端口发布到宿主机，留空即沿用内部端点（http://rustfs:9000），
# 此时浏览器直传改走 PUT /api/storage/upload/stream/{asset_id} 的服务端流式上传；
# 需要浏览器直传时，先经网关/反代让对象存储对外可达，再填该地址。
# STORAGE_S3_PUBLIC_ENDPOINT=https://CHANGE_ME_OBJECT_STORAGE_HOST

# ── 存储服务的资源上限（编排已给安全默认值，这里是覆盖入口）────────────
# 这三个键在代码里默认 0 = 不限制（大文件优先），编排按网关同口径收口：
# 上传 1024 MiB = 网关 client_max_body_size 1024m；回读校验单对象 1024 MiB、
# 600s 墙钟封顶 = 网关 storage 段 proxy_read_timeout 600s。要放开或收紧都在这里改。
# STORAGE_MAX_UPLOAD_MB=1024
# STORAGE_VERIFY_MAX_MB=1024
# STORAGE_VERIFY_TIMEOUT_SECONDS=600

# 数据库连接的 SSL 模式。库与各服务同在 metafusion-net（PostgreSQL 未开 TLS），
# 默认 disable 与现状一致；库一旦搬出宿主网（异地只读副本、迁移、跨网备份）就改成
# require，并在 PostgreSQL 侧配好证书——否则连接串里的口令与数据全走明文。
# DB_SSLMODE=disable

# ── 兄弟仓库目录（可选）──────────────────────────────────────────────
# 编排默认按"与主仓库并列检出"解析（../../metafusion-*）。把兄弟仓库收进主仓库内
# （例如服务器上放在 services/ 下）时，在这里覆盖成相对 deploy/ 的路径：
#   MF_AUTH_DIR=../services/metafusion-auth
#   MF_COMMUNITY_DIR=../services/metafusion-community
#   MF_STORAGE_DIR=../services/metafusion-storage
#   MF_DOCS_DIR=../services/metafusion-docs
# 配套：python scripts/check_versions.py --siblings-root services
