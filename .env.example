# ==============================================================================
# MetaFusion Environment Variables Template
# 复制为 .env 并填入真实值： cp .env.example .env
# 生产环境务必修改所有 CHANGE_ME_* 为强随机值，切勿使用默认值
# ==============================================================================

# 基础端口 (外部反向代理指向此端口，如 Nginx/Caddy 反代 http://127.0.0.1:10100)
HTTP_PORT=10100
MINIO_CONSOLE_PORT=9001

# PostgreSQL 配置
DB_USER=metafusion
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=metafusion_db

# MinIO / S3 访问密钥
MINIO_ROOT_USER=admin_metafusion
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD_MIN_16_CHARS

# S3 公网访问端点 (前端生成直传预签名 URL，本地开发保持 http://localhost:9000)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# 认证与 JWT 密钥 (生产环境必须为 32+ 随机字符)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32_OR_uuidgen

# RS256 访问令牌签发（AUTH_JWT_PRIVATE_KEY 为空则用进程内临时密钥，重启旧令牌失效；
# 生产必须配置持久 RSA 私钥 PEM 或其 base64，可用 openssl genrsa -out jwt.pem 2048 生成）
# 同一把私钥会注入 backend 与 auth：切流后由 auth 签发、其余服务只验签，
# 两边不一致会让已登录用户立刻掉线（见 docs/architecture/cutover-runbook.md 第 0 节）。
# AUTH_JWT_PRIVATE_KEY=CHANGE_ME_RSA_PRIVATE_KEY_PEM_OR_BASE64
# issuer 与 audience 必须与存量令牌一致，默认值即线上值，不要按部署环境改动。
# AUTH_JWT_ISSUER=https://findverse.cc/api
# AUTH_JWT_AUDIENCE=metafusion

# 转码配置
MAX_CONCURRENT_VIDEO_TASKS=2

# 子系统镜像标签（可选）：账号 / 互动 / 存储三个服务的构建镜像统一用它打标签
# METAFUSION_TAG=local

# 存储服务 (metafusion-storage) 预签名直传的对外地址。
# 编排不把对象存储端口发布到宿主机，留空即沿用内部端点（http://rustfs:9000），
# 此时浏览器直传改走 PUT /api/storage/upload/stream/{asset_id} 的服务端流式上传；
# 需要浏览器直传时，先经网关/反代让对象存储对外可达，再填该地址。
# STORAGE_S3_PUBLIC_ENDPOINT=https://CHANGE_ME_OBJECT_STORAGE_HOST

# 可选：外部访问域名（用于预签名 URL 与回调）
# APP_BASE_URL=http://localhost
