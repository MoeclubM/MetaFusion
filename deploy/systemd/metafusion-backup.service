[Unit]
# MetaFusion 每日备份：PostgreSQL + 对象存储（S3 API 逐对象 + 清单/sha256）+ 配置快照
# （脚本自带磁盘护栏与保留策略；对象口径与空桶行为见 docs-local/deploy/backup-restore.md）。
# 脚本路径用 systemd 的 %h（服务用户的 home；本 unit 未设 User=，即 root → /root），
# 不再写死 /root/...：换账号跑或把检出挪进该账号 home 下的别处时，只改这两处的后半段。
# 若检出既不在 home 下、也不由 root 跑，就把下面两行换成实际绝对路径——systemd 不对
# 命令名做环境变量展开，所以这里用不了 EnvironmentFile 传路径。
Description=MetaFusion 每日备份（PostgreSQL + 对象存储（S3 API 逐对象） + 配置快照）
Documentation=file:%h/metafusion/MetaFusion/scripts/backup.sh
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# 容量按真实媒体规模预算（审计 O06）：备份目录上限 20GiB、目标盘常留 ≥5GiB。
# 服务器 / 约 118G（备份与库同盘），对象总量上 GB 级后 2GiB 默认会直接拒绝备份；
# 真装进几十 G 资源时换独立磁盘（见 scripts/backup.sh 头部灾备口径），不要无上限调大。
# RPO 说明：每日一次 ≈ 24h 灾难 RPO；异地副本与小时级 RPO 尚未具备（见同上）。
ExecStart=%h/metafusion/MetaFusion/scripts/backup.sh --keep-days 7 --keep-weeks 4 --max-gb 20 --min-free-gb 5
# 备份是 IO 轻负载（36MB 库 → ~3MB 产物），但别跟业务抢 CPU：降优先级即可，不需要 cpulimit。
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# pg_dump 秒级完成；给足超时是为了大库或磁盘变慢时不误杀。
TimeoutStartSec=30min
